#:kivy 2.1.0
#:import dp kivy.metrics.dp

<SignUpSuccessScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 0.05, 0.05, 0.05, 1
            Rectangle:
                pos: self.pos
                size: self.size

        AnchorLayout:
            anchor_x: "center"
            anchor_y: "center"
            padding: ["16dp", "20dp", "16dp", "20dp"]

            BoxLayout:
                orientation: "vertical"
                size_hint: None, None
                width: min(root.width * 0.88, dp(380))
                height: "220dp"
                padding: ["24dp", "28dp", "24dp", "24dp"]
                spacing: "14dp"

                canvas.before:
                    Color:
                        rgba: 0.08, 0.08, 0.08, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16, 16, 16, 16]

                Label:
                    text: "Usuario creado correctamente"
                    color: 1, 1, 1, 1
                    font_size: "20sp"
                    bold: True
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                Button:
                    id: go_login_button
                    text: "Go to log in"
                    size_hint_y: None
                    height: "52dp"
                    font_size: "16sp"
                    bold: True
                    background_normal: ""
                    background_color: 0.85, 0.85, 0.85, 1
                    color: 0.08, 0.08, 0.08, 1
